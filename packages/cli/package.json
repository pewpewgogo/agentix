{
  "name": "@agentix/cli",
  "version": "0.1.0",
  "description": "Inspect, graph, verify, and scaffold bounded Agentix application changes.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pewpewgogo/agentix.git",
    "directory": "packages/cli"
  },
  "homepage": "https://pewpewgogo.github.io/agentix/",
  "bugs": {
    "url": "https://github.com/pewpewgogo/agentix/issues"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "agentix": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/* *",
    "!dist/**/* *",
    "!dist/*.tsbuildinfo*",
    "!dist/**/*.tsbuildinfo*",
    "!dist/*.test.*",
    "!dist/**/*.test.*",
    "README.md",
    "API.md"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/mark-binaries-executable.mjs dist/bin.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --root ../.. packages/cli"
  },
  "dependencies": {
    "@agentix/compiler": "0.1.0",
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}

{
  "name": "@agentix/core",
  "version": "0.1.0",
  "description": "Typed operations, outcomes, effects, events, and application dispatch for Agentix.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pewpewgogo/agentix.git",
    "directory": "packages/core"
  },
  "homepage": "https://pewpewgogo.github.io/agentix/",
  "bugs": {
    "url": "https://github.com/pewpewgogo/agentix/issues"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/* *",
    "!dist/**/* *",
    "!dist/*.tsbuildinfo*",
    "!dist/**/*.tsbuildinfo*",
    "!dist/*.test.*",
    "!dist/**/*.test.*",
    "README.md",
    "API.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.type-tests.json --pretty false",
    "test": "vitest run --root ../.. packages/core"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "vitest": "4.1.10"
  }
}

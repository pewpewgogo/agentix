{
  "name": "@agentix/compiler",
  "version": "0.1.0",
  "description": "Static architecture analysis and bounded context projection for Agentix applications.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pewpewgogo/agentix.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://pewpewgogo.github.io/agentix/",
  "bugs": {
    "url": "https://github.com/pewpewgogo/agentix/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/* *",
    "!dist/**/* *",
    "!dist/*.tsbuildinfo*",
    "!dist/**/*.tsbuildinfo*",
    "!dist/*.test.*",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --root ../.. packages/compiler"
  },
  "dependencies": {
    "typescript": "7.0.2"
  }
}

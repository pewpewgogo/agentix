{
  "name": "@agentix/testing",
  "version": "0.0.0",
  "description": "Deterministic Agentix operation harnesses, traces, contracts, invariants, and replay.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pewpewgogo/agentix.git",
    "directory": "packages/testing"
  },
  "homepage": "https://pewpewgogo.github.io/agentix/",
  "bugs": {
    "url": "https://github.com/pewpewgogo/agentix/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/* *",
    "!dist/**/* *",
    "!dist/*.tsbuildinfo*",
    "!dist/**/*.tsbuildinfo*",
    "!dist/*.test.*",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --root ../.. packages/testing"
  },
  "dependencies": {
    "@agentix/core": "0.0.0",
    "fast-check": "4.9.0"
  }
}

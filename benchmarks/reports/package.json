{
  "name": "@agentixdev/benchmark-reports",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentix-benchmark-report": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/mark-binaries-executable.mjs dist/cli.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --root ../.. --config benchmarks/reports/vitest.config.ts"
  },
  "dependencies": {
    "@agentixdev/benchmark-harness": "0.0.0"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}

{
  "schemaVersion": 1,
  "id": "task-01-simple-feature",
  "version": 1,
  "category": "simple-feature",
  "userRequest": "Add a promotion-code capability. Authorized callers can create a code with an integer percentage discount from 1 through 90, then fetch it by code. Codes are case-insensitive and stored in uppercase.",
  "publicAcceptanceCriteria": [
    "POST /promotions accepts code and percentOff, returns 201, and records the deterministic creation time.",
    "GET /promotions/:code returns the stored promotion; duplicate codes return 409 and unknown codes return 404.",
    "Creating and reading promotions require promotions:create and promotions:read respectively, with the existing error envelope conventions.",
    "Existing customer, product, order, payment, and event behavior remains unchanged."
  ],
  "expectedPublicSurfaces": [
    {
      "kind": "http",
      "identifier": "POST /promotions",
      "behavior": "Create one normalized promotion."
    },
    {
      "kind": "http",
      "identifier": "GET /promotions/:code",
      "behavior": "Read one normalized promotion."
    }
  ],

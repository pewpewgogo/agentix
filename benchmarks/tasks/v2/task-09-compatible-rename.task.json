  "id": "task-09-compatible-rename",
  "version": 1,
  "category": "compatible-operation-rename",
  "userRequest": "Rename the public order-placement operation from POST /orders to POST /purchases. Existing consumers of POST /orders must remain compatible as a deprecated alias with identical authorization, validation, status, response, and side effects.",
  "publicAcceptanceCriteria": [
    "POST /purchases creates an order with exactly the same observable behavior as the current order-placement operation.",
    "POST /orders remains supported as a compatibility alias and does not create duplicate payments or events.",
    "Both paths require the same permission and return identical domain and validation errors.",
    "Order lookup and event-feed paths remain unchanged."
  ],
  "expectedPublicSurfaces": [
    {
      "kind": "http",
      "identifier": "POST /purchases",
      "behavior": "Primary order-placement operation."
    },
    {
      "kind": "http",
      "identifier": "POST /orders",
      "behavior": "Deprecated compatible alias."
    }
  ],

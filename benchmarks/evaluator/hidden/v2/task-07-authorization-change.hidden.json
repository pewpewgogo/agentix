{
  "schemaVersion": 1,
  "taskId": "task-07-authorization-change",
  "taskVersion": 1,
  "evaluatorVersion": 1,
  "checks": [
    {
      "id": "catalog-permission-matrix",
      "kind": "black-box",
      "implementations": [
        "framework",
        "plain"
      ],
      "driver": "commerce-http",
      "scenario": "Attempt product creation with no permission, only the old permission, only catalog:write, and both permissions.",
      "assertions": [
        "Only principals containing catalog:write are authorized.",
        "Denied attempts create no product.",
        "The response envelope stays unchanged."
      ]
    },
    {
      "id": "authorization-before-input",
      "kind": "black-box",
      "implementations": [
        "framework",
        "plain"
      ],
      "driver": "commerce-http",
      "scenario": "Send missing and malformed product bodies under denied and authorized principals, then exercise every other route permission.",
      "assertions": [
        "Denied malformed requests return 403 before body parsing.",
        "Authorized malformed requests return 400.",
        "No unrelated permission changes."
      ]
    },
    {
      "id": "full-regression",
      "kind": "regression-command",
      "implementations": [
        "framework",
        "plain"
      ],
      "commandByImplementation": {
        "framework": [
          "npm",
          "--workspace",
          "@agentix/framework-app",
          "test"
        ],
        "plain": [
          "npm",
          "--workspace",
          "@agentix/plain-app",
          "test"
        ]
      },
      "expectedExitCode": 0
    }
  ],
  "shortcutPolicy": {
    "forbiddenModifiedPrefixes": [
      "benchmarks/evaluator",
      "benchmarks/harness",
      "benchmarks/results"
    ],
    "rejectDeletedTests": true,

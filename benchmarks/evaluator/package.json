{
  "name": "@agentixdev/benchmark-evaluator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --root ../.. benchmarks/evaluator",
    "freeze:check": "tsx src/freeze.ts ../.."
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agentixdev/benchmark-harness": "0.0.0",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

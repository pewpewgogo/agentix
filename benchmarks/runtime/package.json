{
  "name": "@agentixdev/benchmark-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentix-runtime-benchmark": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/mark-binaries-executable.mjs dist/cli.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --root ../.. benchmarks/runtime"
  },
  "dependencies": {
    "@agentixdev/compiler": "0.0.0",
    "@agentixdev/core": "0.0.0",
    "@agentixdev/framework-app": "0.0.0",
    "@agentixdev/plain-app": "0.0.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "vitest": "4.1.10"
  }
}

{
  "name": "agentix-research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "examples/shared-contract",
    "examples/plain-app"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run examples/shared-contract examples/plain-app",
    "benchmark:public": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}

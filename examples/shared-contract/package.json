{
  "name": "@agentixdev/shared-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./acceptance": {
      "types": "./dist/acceptance.d.ts",
      "default": "./dist/acceptance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",

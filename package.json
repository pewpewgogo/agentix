{
  "name": "agentix",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pewpewgogo/agentix.git"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*",
    "benchmarks/*",
    "sandbox/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/mark-binaries-executable.mjs",
    "clean": "tsc -b --clean && node scripts/clean.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p packages/compiler/tsconfig.test.json --pretty false && tsc -p packages/cli/tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:phase2": "npm run typecheck && vitest run packages",
    "test:acceptance": "vitest run examples/framework-app examples/plain-app",
    "test:phase3": "npm run typecheck && npm run test:acceptance",
    "test:phase5": "npm run typecheck && vitest run benchmarks/evaluator benchmarks/harness benchmarks/reports benchmarks/runtime",
    "benchmark:corpus:check": "npm run freeze:check --workspace @agentixdev/benchmark-evaluator",
    "benchmark:corpus:refresh": "node scripts/refresh-benchmark-freeze.mjs",
    "benchmark:corpus:v2:check": "npm run freeze:check:v2 --workspace @agentixdev/benchmark-evaluator",
    "benchmark:corpus:v2:refresh": "node scripts/refresh-benchmark-freeze-v2.mjs",
    "benchmark:corpus:v2:dryrun": "npm run build && npm run dryrun:v2 --workspace @agentixdev/benchmark-evaluator",
    "benchmark:harness:smoke": "vitest run benchmarks/harness/src/runner.test.ts",
    "benchmark:runtime:smoke": "npm run build && node benchmarks/runtime/dist/cli.js --smoke --no-process",
    "benchmark:http-frameworks": "npm run build && node benchmarks/runtime/dist/http-comparison/cli.js",
    "sandbox:test": "npm run build && vitest run sandbox/notes-app sandbox/plain-notes-app sandbox/nestjs-notes-app",
    "sandbox:token-budget": "npm run build && node sandbox/token-budget/run.mjs",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release:publish": "npm run clean && npm run build && changeset publish",
    "release:check": "node scripts/check-release-packages.mjs",
    "release:status": "changeset status",
    "github:test:pack": "node scripts/prepare-github-test-release.mjs",
    "github:test:check": "npm run github:test:pack -- --version=0.0.0-github.ci --tag=github-test-v0.0.0-github.ci",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "26.1.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
